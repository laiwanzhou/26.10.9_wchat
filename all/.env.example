# 本地开发（Development）：复制后填写，不提交 .env。
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/yanxi?connect_timeout=3
PUBLIC_BASE_URL=http://127.0.0.1:3000
ADMIN_ORIGIN=http://127.0.0.1:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 容器部署（Container Deployment）另需 URL 安全字符的随机数据库密码。
POSTGRES_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
VITE_ADMIN_MODE=service
# 管理网页使用同源 /api 代理（Same-origin Proxy）。
