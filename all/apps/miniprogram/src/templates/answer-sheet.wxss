.quiz-status{display:flex;justify-content:space-between;font-size:23rpx;color:#92a082;align-items:center;gap:20rpx}.quiz-status>text:first-child{font-weight:500}.quiz-current{font-size:37rpx;color:#5d7f4a;margin-right:9rpx}.quiz-progress{height:7rpx;background:#e9eddf;border-radius:8rpx;margin:25rpx 0 35rpx;overflow:hidden}.quiz-progress>view{height:100%;background:#94b17b;transition:width .3s}.quiz-card{background:#fff;border:1rpx solid #e6ebdb;border-radius:24rpx;padding:32rpx;margin-bottom:30rpx}.quiz-card-heading{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.sample-label{font-size:18rpx;color:#b1bca5}.quiz-stem{font-size:36rpx;line-height:1.8;white-space:pre-wrap;margin:32rpx 0 34rpx;color:#4b6041}.answer-hint{font-size:22rpx;color:#9baa89;margin-bottom:22rpx}.quiz-option{display:block;border:2rpx solid #e6ebdf;border-radius:17rpx;padding:21rpx;margin-bottom:18rpx;color:#7d8e70;background:#fff;transition:background .15s,border-color .15s}.quiz-option.selected{border-color:#83a36a;background:#f4f8ed}.quiz-option.correct{border-color:#83ad8d;background:#eff7ee}.quiz-option.wrong{border-color:#d4a177;background:#fbf1e6}.option-row{display:flex;align-items:center;gap:16rpx;font-size:27rpx}.option-row radio{transform:scale(.78);flex-shrink:0;margin-right:-6rpx}.option-letter{color:#91a780;font-size:22rpx}.option-label{flex:1}.option-result{color:#639272;font-size:29rpx}.wrong-mark{color:#bd8b60}.option-image{display:block;width:100%;height:190rpx;border-radius:11rpx;margin-bottom:20rpx;background:#f0f3e9}.image-options{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16rpx}.image-options .quiz-option{width:calc(50% - 8rpx);padding:13rpx;margin-bottom:0}.image-options .option-row{gap:6rpx;font-size:23rpx}.image-options .option-letter{font-size:18rpx}.image-options .option-image{height:180rpx;margin-bottom:12rpx}.fill-input{padding:25rpx;height:93rpx;background:#f7f9f1;border:2rpx solid #e4eadd;border-radius:13rpx;font-size:28rpx;color:#5c7550}.input-note{font-size:19rpx;color:#b1bca2;margin-top:18rpx;line-height:1.8}.answer-feedback{padding:28rpx;border-radius:17rpx;border:1rpx solid;margin-bottom:30rpx}.answer-feedback.right{background:#ecf4e4;border-color:#d9e7cc}.answer-feedback.wrong{background:#faf2e3;border-color:#ebdfc8}.feedback-title{font-size:27rpx;font-weight:500;color:#718d56}.wrong .feedback-title{color:#a58c56}.standard-answer{font-size:24rpx;color:#80916e;margin-top:19rpx}.explanation{font-size:22rpx;color:#9aa88a;line-height:1.9;margin-top:16rpx}.error-back{margin-top:30rpx}.submit-button[disabled]{background:#e6ecde;color:#a3b295}
