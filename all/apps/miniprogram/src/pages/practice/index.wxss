.practice-tip{display:flex;align-items:center;gap:25rpx;background:#eef3e5;border-radius:17rpx;padding:24rpx;margin-top:30rpx;color:#839c69}.practice-tip>text{font-size:39rpx}.practice-tip>view>view{font-size:25rpx}.practice-tip>view>text{font-size:20rpx;color:#a2b38d;margin-top:9rpx;display:block}.practice-entry{display:flex;align-items:center;gap:25rpx;padding:31rpx 25rpx}.practice-mark{width:78rpx;height:88rpx;border-radius:18rpx;font:44rpx KaiTi,serif;display:flex;align-items:center;justify-content:center}.practice-copy{flex:1}.practice-copy>view:first-child{font-size:29rpx;font-weight:500}.practice-copy>text{font-size:21rpx;color:#9dab90;display:block;margin-top:10rpx}.question-count{font-size:18rpx;color:#aab69e;margin-top:15rpx}
.practice-entry{width:100%;text-align:left;line-height:1.5}.practice-entry-active{background:#f0f6e9;border-color:#d8e5c9}.practice-mark{flex-shrink:0}.practice-copy>view:first-child{font-size:28rpx}
