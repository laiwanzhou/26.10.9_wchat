<view class="screen"><page-state wx:if="{{status!=='ready'}}" status="{{status}}" title="没有找到这个词条" message="{{errorMessage}}" bindretry="load" /><block wx:elif="{{word}}"><view class="word-header"><view class="eyebrow">A WORD FOR TODAY</view><view class="word-character">{{word.text}}</view><view class="word-pronunciation">{{word.pinyin}}</view><view class="chip">词条详情</view></view><view class="card"><view class="word-section-title">释义</view><view class="word-copy">{{word.definition}}</view><view class="soft-divider"></view><view class="word-section-title">例句</view><view class="example-box">“{{word.example}}”</view></view><view class="demo-note">当前使用独立模拟服务，正式数据后续接入</view></block></view>
