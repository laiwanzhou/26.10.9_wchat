.result-screen{text-align:center;padding-top:50rpx}.result-seal{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;background:#e7efda;border:1rpx solid #d4e2c2;border-radius:50%;color:#8ba76c;font-size:40rpx;margin:0 auto 30rpx}.result-screen .page-title{font-size:36rpx}.score-ring{width:290rpx;height:290rpx;border:10rpx solid #dce8cd;border-top-color:#88a66b;border-right-color:#88a66b;border-radius:50%;margin:55rpx auto 40rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}.score-value{font-size:85rpx;font-weight:500;color:#6b8a4f}.score-value text{font-size:28rpx;margin-left:5rpx}.score-caption{font-size:23rpx;color:#a1b28b;margin-top:13rpx}.result-stats{display:flex;justify-content:space-around;background:#fff;border:1rpx solid #e5ebdb;border-radius:21rpx;padding:29rpx;margin-bottom:40rpx}.result-stats text{font-size:37rpx;color:#6b8154}.result-stats view>view{font-size:21rpx;color:#9fad90;margin-top:12rpx}.secondary-button{margin-top:20rpx}.history-link{color:#8a9e75;font-size:23rpx;margin-top:30rpx}
