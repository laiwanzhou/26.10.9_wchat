.scenario-card{display:flex;justify-content:space-between;align-items:center;text-align:left;padding:24rpx;margin-bottom:16rpx;background:white;border:2rpx solid #e4eadb;border-radius:18rpx;width:100%}.scenario-card.selected{border-color:#91ad77;background:#f1f6e9}.scenario-card>view>view{font-size:27rpx;color:#728b5a}.scenario-card>view>text{font-size:21rpx;color:#a1b090;display:block;margin-top:11rpx}.scenario-card>text{color:#9caf83;font-size:32rpx}.form-label{font-size:23rpx;color:#82976e;margin:21rpx 0 15rpx}.preview-form input{height:85rpx;border:1rpx solid #e0e7d6;border-radius:12rpx;padding:20rpx;font-size:24rpx;background:#f8faf3}.banner-list{display:flex;flex-wrap:wrap;gap:18rpx}.banner-choice{width:calc(50% - 9rpx);text-align:left;background:#f8faf3;padding:10rpx;border:2rpx solid #e3e9d9;border-radius:13rpx}.banner-choice.selected{border-color:#8caa70}.banner-choice image,.no-image{width:100%;height:140rpx;border-radius:9rpx}.no-image{display:flex;justify-content:center;align-items:center;background:#eaf0df;color:#99af81;font-size:48rpx}.banner-choice>text{display:block;font-size:21rpx;padding:12rpx 7rpx;color:#8b9f75}.reset-preview{margin-top:20rpx}
