.home-greeting{font-size:23rpx;color:#899b77;display:flex;justify-content:space-between;align-items:center;margin-bottom:25rpx}.greeting-dot{font-size:16rpx;color:#a7bd90}.hero{background:#e7edd9;border:1rpx solid #dfe8cf;border-radius:27rpx;padding:40rpx 34rpx;position:relative;overflow:hidden;min-height:395rpx}.hero .eyebrow{font-size:15rpx;letter-spacing:3rpx;color:#8f9e78}.hero-title{font-size:53rpx;line-height:1.42;letter-spacing:4rpx;color:#4c6840;margin-top:22rpx;font-weight:500}.hero-desc{font-size:22rpx;line-height:1.8;color:#8a9978;margin-top:19rpx}.hero-link{font-size:23rpx;color:#66854b;margin-top:28rpx;font-weight:500}.hero-link text{margin-left:15rpx}.hero-art{position:absolute;width:210rpx;height:260rpx;right:12rpx;top:105rpx}.hero-ring{position:absolute;width:225rpx;height:225rpx;border:1rpx solid #cfdcc0;border-radius:50%;right:-10rpx;top:-15rpx}.hero-character{position:absolute;left:20rpx;top:20rpx;display:flex;justify-content:center;align-items:center;background:#719663;color:#ecf0df;width:113rpx;height:150rpx;border-left:7rpx solid #99b388;border-radius:6rpx 13rpx 13rpx 6rpx;transform:rotate(-13deg);font:80rpx KaiTi,serif}.hero-small{position:absolute;left:110rpx;top:112rpx;display:flex;justify-content:center;align-items:center;background:#c5af70;color:#f9f6e7;width:80rpx;height:100rpx;transform:rotate(13deg);border-radius:8rpx;font:52rpx KaiTi,serif}.progress-strip{display:flex;align-items:center;padding:28rpx 12rpx 0;gap:25rpx;font-size:18rpx;color:#a0ad92}.progress-strip>view{display:flex;align-items:center;gap:10rpx}.progress-number{font-size:34rpx;color:#687f55;font-weight:500}.progress-divider{width:1rpx;height:26rpx;background:#dfe5d5}.progress-caption{margin-left:auto;font-size:17rpx}.category-grid{display:flex;flex-wrap:wrap;justify-content:space-between;gap:20rpx}.category-card{background:#fff;border:1rpx solid #e6ebdb;border-radius:22rpx;padding:25rpx;width:calc(50% - 10rpx)}.category-mark{width:60rpx;height:60rpx;display:flex;justify-content:center;align-items:center;border-radius:16rpx;font:36rpx KaiTi,serif}.category-title{font-size:28rpx;font-weight:500;margin-top:20rpx}.category-caption{font-size:19rpx;color:#9fae91;margin-top:12rpx;display:flex;justify-content:space-between}.category-caption text{font-size:29rpx;color:#a4b593}.word-card{background:#fff;border:1rpx solid #e5ebda;border-radius:23rpx;padding:30rpx;display:flex;justify-content:space-between;align-items:center}.word-main{font-size:42rpx;font-weight:500;color:#5b7950}.word-pinyin{font-size:22rpx;color:#9cae8c;margin-left:25rpx}.word-definition{font-size:22rpx;line-height:1.8;color:#94a085;margin-top:19rpx}.word-arrow{font-size:35rpx;color:#a8b79a;margin-left:20rpx}.competition-card{position:relative;overflow:hidden;background:#f2ebdb;border:1rpx solid #e9dfc9;border-radius:24rpx;padding:32rpx;margin-top:35rpx}.competition-card .chip{background:#e8dfc6;color:#9f8957}.competition-title{font-size:32rpx;color:#887246;font-weight:500;margin-top:24rpx}.competition-desc{font-size:20rpx;color:#ab9b7b;margin-top:13rpx}.competition-link{font-size:22rpx;color:#8e7a4e;margin-top:25rpx}.competition-art{position:absolute;font:112rpx KaiTi,serif;color:#daceaf;right:25rpx;top:40rpx;transform:rotate(-10deg)}
.home-shortcuts{display:flex;gap:18rpx;margin:18rpx 0 30rpx}.home-shortcuts button{flex:1;background:white;border:1rpx solid #e3e9d9;border-radius:17rpx;padding:20rpx 10rpx;color:#8da176;font-size:21rpx;line-height:1.8}.home-shortcuts button>text{font:33rpx KaiTi,serif;color:#6f9255;display:block}.hero-cover{position:absolute;inset:0;width:100%;height:100%;opacity:.23}.hero-copy{position:relative;z-index:1}.hero-title{max-width:340rpx;white-space:pre-line}.hero-desc{max-width:360rpx}.banner-fallback-note{position:relative;font-size:18rpx;color:#95a67c;margin-top:17rpx}.preview-settings-link{font-size:21rpx;color:#98ac80;text-align:center;margin-top:36rpx}
