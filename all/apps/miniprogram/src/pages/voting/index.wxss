.competition-heading{padding:24rpx 25rpx 35rpx;background:#f1ebdb;border-radius:25rpx;position:relative;overflow:hidden}.competition-heading .chip{background:#e9dfc7;color:#a89467}.competition-heading .page-title{font-size:37rpx;color:#92794c;position:relative;z-index:1;margin-top:28rpx}.competition-heading .page-description{color:#b0a081;font-size:21rpx}.competition-symbol{position:absolute;font:140rpx KaiTi,serif;right:2rpx;bottom:30rpx;color:#ddd1b6;transform:rotate(-8deg)}.vote-notice{font-size:20rpx;line-height:1.9;color:#b09d78;padding:22rpx 6rpx 0}.candidate-grid{display:flex;flex-wrap:wrap;gap:23rpx;justify-content:space-between}.candidate-card{width:calc(50% - 12rpx);border:1rpx solid #e4ead8;border-radius:22rpx;background:#fff;overflow:hidden}.candidate-cover{height:220rpx;display:flex;align-items:center;justify-content:center;position:relative}.candidate-cover>text{font:102rpx KaiTi,serif;opacity:.52}.candidate-number{position:absolute;left:18rpx;top:17rpx;font-size:16rpx;letter-spacing:2rpx;opacity:.65}.candidate-copy{padding:23rpx}.candidate-name{font-size:28rpx;color:#6c8458;font-weight:500}.candidate-intro{font-size:20rpx;color:#a5b094;line-height:1.85;margin-top:13rpx;height:73rpx;overflow:hidden}.candidate-link{color:#8d9f76;font-size:20rpx;margin-top:20rpx}
