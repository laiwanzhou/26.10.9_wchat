<view class="screen"><page-state wx:if="{{status!=='ready'}}" status="{{status}}" title="没有找到这位选手" message="{{errorMessage}}" bindretry="load" /><block wx:elif="{{candidate}}"><view class="candidate-portrait" style="background:{{candidate.color}}"><image wx:if="{{candidate.photo && !photoFailed}}" class="portrait-image" src="{{candidate.photo}}" mode="aspectFill" binderror="photoError" /><text wx:else>{{candidate.mark}}</text><view class="portrait-number">NO. {{candidate.number}}</view><view wx:if="{{!candidate.photo || photoFailed}}" class="portrait-caption">照片待提供</view></view><view class="candidate-title">{{candidate.name}}</view><view class="candidate-subtitle">语言大赛 · 选手介绍</view><view class="card"><view class="intro-label">关于这位选手</view><view class="intro-copy">{{candidate.intro}}</view></view><button class="primary-button" disabled>投票功能尚未开放</button><view class="demo-note">后端接入后按每日 IP 额度开放投票<text>{{'\n'}}</text>北京时间每天 04:00 刷新额度</view></block></view>
