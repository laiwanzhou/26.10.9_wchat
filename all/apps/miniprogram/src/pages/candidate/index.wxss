.candidate-portrait{height:430rpx;border-radius:25rpx;display:flex;align-items:center;justify-content:center;position:relative}.candidate-portrait>text{font:180rpx KaiTi,serif;opacity:.5}.portrait-number{position:absolute;left:30rpx;top:30rpx;font-size:22rpx;letter-spacing:4rpx;opacity:.7}.portrait-caption{position:absolute;bottom:25rpx;font-size:20rpx;opacity:.6}.candidate-title{font-size:44rpx;color:#678551;margin:32rpx 0 10rpx;font-weight:500}.candidate-subtitle{font-size:22rpx;color:#a6b397;margin-bottom:32rpx}.intro-label{font-size:24rpx;color:#859c6f}.intro-copy{font-size:28rpx;color:#97a788;line-height:2;margin-top:22rpx}.primary-button{margin-top:30rpx}
.portrait-image{position:absolute;inset:0;width:100%;height:100%;border-radius:25rpx}.portrait-number,.portrait-caption{z-index:1}
