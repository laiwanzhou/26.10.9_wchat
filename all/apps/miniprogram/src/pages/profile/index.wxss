.profile-header{display:flex;align-items:center;gap:27rpx;margin-top:25rpx}.profile-avatar{width:100rpx;height:100rpx;border-radius:27rpx;display:flex;align-items:center;justify-content:center;background:#e5edda;border:1rpx solid #d6e1c5;color:#87a66b;font:57rpx KaiTi,serif}.profile-title{font-size:36rpx;color:#67834f;font-weight:500}.profile-subtitle{font-size:21rpx;color:#a4b28f;margin-top:15rpx}.local-badge{font-size:19rpx;color:#a9b89a;margin:25rpx 0 32rpx}.profile-stats{display:flex;justify-content:space-around;padding:33rpx;background:#edf3e3;border:1rpx solid #e3ead6;border-radius:23rpx;text-align:center}.profile-stats text{font-size:43rpx;color:#749057;font-weight:500}.profile-stats view>view{font-size:20rpx;color:#a0b187;margin-top:12rpx}.history-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.history-title{font-size:27rpx;color:#7c9168}.history-date{font-size:19rpx;color:#a9b799;margin-top:15rpx}.history-score{font-size:37rpx;color:#95ac7d}.history-score text{font-size:20rpx;margin-left:4rpx}.start-button{margin-top:36rpx;max-width:300rpx}
.profile-preview-entry{display:flex;justify-content:space-between;align-items:center;margin:0 36rpx 55rpx;padding:28rpx;background:#fff;border:1rpx solid #e3e9d9;border-radius:18rpx}.profile-preview-entry>view>view{font-size:26rpx;color:#7f9568}.profile-preview-entry>view>text{font-size:20rpx;color:#a8b698;display:block;margin-top:12rpx}.profile-preview-entry>text{font-size:38rpx;color:#a4b68e}
.profile-preview-entry{margin:30rpx 0 0}
