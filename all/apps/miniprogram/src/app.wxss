page{background:#fafaf4;color:#304234;font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei",sans-serif;font-size:28rpx}view,text,button,input{box-sizing:border-box}button{font-size:28rpx;font-weight:500;border-radius:16rpx;margin:0;line-height:1.5}button::after{border:none}button[disabled]{background:#e7ece1;color:#a0ad95}.screen{padding:36rpx 36rpx 56rpx}.eyebrow{font-size:18rpx;letter-spacing:4rpx;color:#8da17a}.page-title{font-size:46rpx;letter-spacing:2rpx;font-weight:600;margin:14rpx 0 16rpx}.page-description{font-size:24rpx;line-height:1.8;color:#98a48c}.section-heading{display:flex;align-items:center;justify-content:space-between;margin:44rpx 0 24rpx}.section-title{font-size:31rpx;font-weight:600}.section-link{font-size:22rpx;color:#7f9570}.card{background:white;border:1rpx solid #e7ecdf;border-radius:24rpx;padding:30rpx;margin-bottom:22rpx}.demo-note{font-size:20rpx;color:#a1ad95;line-height:1.9;margin:28rpx 0;text-align:center}.chip{display:inline-block;padding:7rpx 14rpx;border-radius:9rpx;background:#edf3e5;color:#7b9565;font-size:19rpx}.primary-button{background:#397c5b;color:white;padding:25rpx;text-align:center;border-radius:16rpx;font-size:27rpx;width:100%}.secondary-button{background:white;border:1rpx solid #e1e8d8;color:#758765;padding:24rpx;width:100%;font-size:26rpx}.empty{padding:75rpx 20rpx;text-align:center;color:#8c9f79}.empty-mark{font-size:68rpx;color:#a9bd93;margin-bottom:25rpx}.empty-title{font-size:29rpx;font-weight:500}.empty-desc{font-size:23rpx;line-height:1.8;margin-top:17rpx}.green{background:#e5edda;color:#60824d}.blue{background:#e4edf2;color:#6d8fa7}.amber{background:#f4ead7;color:#b59b5d}.purple{background:#ece6f2;color:#9a83b0}.arrow{color:#aab89d;font-size:37rpx}.row{display:flex;align-items:center}.soft-divider{height:1rpx;background:#edf0e7;margin:26rpx 0}.search-box{background:white;border:1rpx solid #e5eade;border-radius:16rpx;display:flex;align-items:center;padding:20rpx 24rpx;margin:30rpx 0;gap:16rpx}.search-symbol{font-size:30rpx;color:#9dad8e}.search-box input{font-size:24rpx;flex:1}.search-clear{color:#98a98c;padding:0 10rpx}.pill-tabs{display:flex;gap:18rpx;margin:28rpx 0}.pill-tab{font-size:24rpx;color:#9ca98f;border-radius:12rpx;padding:14rpx 27rpx}.pill-tab.active{background:#eaf1df;color:#67864e}.landscape{height:185rpx;background:#d8e6cb;border-radius:16rpx;position:relative;overflow:hidden}.landscape .sun{position:absolute;right:38rpx;top:28rpx;width:35rpx;height:35rpx;border-radius:50%;background:#f2e8b8}.landscape .hill{position:absolute;width:370rpx;height:160rpx;left:-90rpx;top:90rpx;background:#92b779;border-radius:50%;transform:rotate(-12deg)}.landscape .hill-two{position:absolute;width:360rpx;height:170rpx;left:80rpx;top:100rpx;background:#658f58;border-radius:50%;transform:rotate(15deg)}.landscape.snow{background:#dae8ee}.landscape.snow .hill{background:#b3c7d1;border-radius:12rpx;transform:rotate(45deg);width:180rpx;height:180rpx;left:25rpx;top:70rpx}.landscape.snow .hill-two{background:#f0f5f6;border-radius:7rpx;transform:rotate(45deg);width:180rpx;height:180rpx;left:170rpx;top:88rpx}
