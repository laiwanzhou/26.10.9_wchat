.resource-state{text-align:center;padding:75rpx 28rpx;color:#879a74}.state-title{font-size:29rpx;font-weight:500;margin:24rpx 0 16rpx}.state-message{font-size:22rpx;line-height:1.9;color:#a2b092}.state-symbol{width:87rpx;height:87rpx;background:#edf3e3;border-radius:24rpx;display:flex;align-items:center;justify-content:center;margin:auto;color:#96ae7d;font-size:50rpx}.state-symbol.error{background:#faf0df;color:#baa16e}.state-button{font-size:24rpx;color:#6c8a52;border:1rpx solid #dce6cd;border-radius:15rpx;background:white;padding:20rpx 35rpx;margin:35rpx auto 0;line-height:1.5;max-width:280rpx}.state-button::after{border:none}.state-spinner{width:60rpx;height:60rpx;border:5rpx solid #e4ebd9;border-top-color:#8ea873;border-radius:50%;margin:auto;animation:turn 1s linear infinite}.skeleton{margin-top:40rpx}.skeleton>view{height:25rpx;background:#eaf0e1;border-radius:8rpx;margin:19rpx 0;animation:pulse 1.2s ease-in-out infinite}.skeleton>view:last-child{width:65%;margin:auto}@keyframes turn{to{transform:rotate(360deg)}}@keyframes pulse{50%{opacity:.45}}
